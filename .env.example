# ════════════════════════════════════════════════════════════════
#  ARCANCHILE · Variables de entorno
#  Copia este archivo a  .env  y completa los valores.
#  Si dejas .env sin crear, la app corre en MODO DEMO local (localStorage).
# ════════════════════════════════════════════════════════════════

# ── Cliente (navegador) ──
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

# ── Solo para el seed (npm run seed) ──
# Supabase → Project Settings → API → service_role key.
# ⚠️  SECRETA: úsala solo localmente, NUNCA la subas al repositorio
#     ni la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
